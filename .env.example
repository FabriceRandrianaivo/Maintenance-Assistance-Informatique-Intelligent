# Configuration des acces aux modeles de langage.
#
# Copier ce fichier en `.env` a la racine du projet et y renseigner les cles.
# Le fichier `.env` est ignore par Git : aucune cle ne doit etre versionnee.
#
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# Le systeme fonctionne sans aucune cle : il bascule alors en mode regles
# seules. Les cles ameliorent la qualite des reponses, elles ne conditionnent
# pas le fonctionnement du prototype.

# --- Niveau 1 : Groq (recommande) -------------------------------------------
# Cle gratuite sur https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Niveau 2 : Google Gemini (secours) --------------------------------------
# Cle gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Niveau 3 : Ollama (secours local, hors ligne) ---------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
